{
  "name": "smartedu-library-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A local-first textbook library for resources the user can access through SmartEdu.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/run4u/smartedu-textbook-library.git"
  },
  "author": {
    "name": "run4u",
    "url": "https://github.com/run4u"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5178 --strictPort\" \"wait-on http://127.0.0.1:5178 && electron .\"",
    "web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "io.github.run4u.smartedu-textbook-library",
    "productName": "SmartEdu Textbook Library",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    }
  }
}
