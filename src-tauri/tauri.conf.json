{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SmartEdu Textbook Library Lite",
  "version": "0.1.3-alpha.1",
  "identifier": "io.github.run4u.smartedu-textbook-library-lite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5178",
    "beforeDevCommand": "npm run web -- --port 5178 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SmartEdu Textbook Library Lite",
        "width": 1440,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
